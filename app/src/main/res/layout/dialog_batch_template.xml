<?xml version="1.0" encoding="utf-8"?>
<!--
  批量生成模板（对应 CA 菜单里的「创建批量生成模板」）。

  用途：一条命令里的某个参数有多个取值时，一次生成多条命令。例如
    give @s diamond_sword {n}          n = 1,2,3  →  生成 3 条
    titleraw @a title {"rawtext":[{"text":"第{i}关"}]}

  上下两块：上面写模板，下面写每个占位符的取值列表，中间是生成结果预览。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_card"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingBottom="8dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/dialog_item_padding_horizontal"
        android:paddingEnd="@dimen/dialog_item_padding_horizontal"
        android:paddingBottom="8dp"
        android:text="@string/batch_dialog_title"
        android:textColor="@color/text_primary"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/dialog_item_padding_horizontal"
        android:paddingEnd="@dimen/dialog_item_padding_horizontal"
        android:paddingBottom="4dp"
        android:text="@string/batch_template_label"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/templateInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_code_area"
        android:fontFamily="monospace"
        android:gravity="top|start"
        android:hint="@string/batch_template_hint"
        android:inputType="textMultiLine|textNoSuggestions"
        android:minHeight="72dp"
        android:padding="8dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_disabled"
        android:textSize="12sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/dialog_item_padding_horizontal"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/dialog_item_padding_horizontal"
        android:paddingBottom="4dp"
        android:text="@string/batch_values_label"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <!-- 占位符取值行由代码动态加入：每行一个「占位符名 = 取值1,取值2」 -->
    <LinearLayout
        android:id="@+id/valuesContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/dialog_item_padding_horizontal"
        android:paddingEnd="@dimen/dialog_item_padding_horizontal" />

    <TextView
        android:id="@+id/batchCountText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/dialog_item_padding_horizontal"
        android:paddingTop="10dp"
        android:paddingEnd="@dimen/dialog_item_padding_horizontal"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:background="@color/dialog_divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/batchCloseButton"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/dialog_close"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/batchPreviewButton"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/batch_preview"
            android:textColor="@color/brand_teal"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/batchSaveButton"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/batch_save"
            android:textColor="@color/brand_teal"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/batchCopyButton"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/batch_copy_all"
            android:textColor="@color/brand_teal"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
