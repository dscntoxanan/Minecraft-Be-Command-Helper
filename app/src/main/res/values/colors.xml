<?xml version="1.0" encoding="utf-8"?>
<!-- 命令助手配色。取自原版界面取色，保持浅色调 + 青绿点缀的风格。 -->
<resources>
    <!-- 面板底色：原版是纯白，浅灰只用在标题栏与分隔线 -->
    <color name="panel_background">#FFFFFFFF</color>
    <color name="panel_header">#FFF2F2F2</color>
    <color name="panel_divider">#FFE0E0E0</color>

    <!-- 输入栏（底部横条） -->
    <color name="input_bar_background">#FFF7F7F7</color>
    <color name="input_bar_text">#FF212121</color>
    <color name="input_bar_hint">#FF9E9E9E</color>

    <!-- 文字 -->
    <color name="text_primary">#FF212121</color>
    <color name="text_secondary">#FF757575</color>
    <color name="text_disabled">#FFBDBDBD</color>

    <!-- 主色：原版输入光标与「+」按钮附近是青绿色 -->
    <color name="brand_teal">#FF009688</color>
    <color name="brand_teal_dark">#FF00796B</color>
    <color name="brand_teal_light">#FFB2DFDB</color>

    <!-- 状态 -->
    <color name="selected_item">#FFE0F2F1</color>
    <color name="scrim">#66000000</color>
    <!-- 错误提示：取自原版命令助手的红字（"价格不是整数"那一行） -->
    <color name="error_red">#FFE53935</color>

    <!-- 对话框：原版菜单是居中弹出的白卡片 -->
    <color name="dialog_background">#FFFFFFFF</color>
    <color name="dialog_item_pressed">#FFF5F5F5</color>
    <color name="dialog_divider">#FFEEEEEE</color>
</resources>
